# ───────────────────────────────────────────────────────────────
# Auto Trade (주식) — 환경변수 예시. 이 파일을 복사해 .env로 저장하세요.
#   cp .env.example .env  후 값 채우기 (.env는 .gitignore로 커밋 금지)
# ───────────────────────────────────────────────────────────────

# ── 한국투자증권 KIS Open API (실시간 시세/거래량 폭주 모니터) ──
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                 # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT_CODE=01     # 계좌상품코드 뒤 2자리 (보통 01)
KIS_ENV=real                    # real(실전) | paper(모의)

# ── Anthropic Claude (에이전트) ──
ANTHROPIC_API_KEY=
STOCK_AGENT_MODEL=claude-opus-4-8   # 비용 절감 시 claude-haiku-4-5 등으로 변경

# ── Notion (배치 결과 아카이브 — 없어도 텔레그램으로는 옵니다) ──
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=          # 요약/문서 페이지를 붙일 부모 페이지 ID
NOTION_RECO_DB_ID=              # '오늘의 추천' DB ID (최초 셋업 후 채움)

# ── Telegram (일일 추천 다이제스트 + 실시간 폭주 알림) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 데이터 루트(선택) ──
# 이 폴더 하나 아래에 ohlcv_cache / universe / earnings / profiles /
# observations / tracking 이 자동으로 만들어진다.
# 비워 두면 프로그램 실행 폴더의 data/ 를 쓴다.
# GCE에서 영구 디스크를 쓰려면 예: STOCK_DATA_DIR=/mnt/stock-data
STOCK_DATA_DIR=data

# ── 실시간 감시 종목 수 상한(선택) ──
# KIS는 접속당 실시간 등록 건수가 제한된다(정규 40건 내외).
KIS_MAX_SUBSCRIPTIONS=40

# ── 한국 시장도 켤 때만(선택) ── 기본은 미국장 전용
# ENABLE_KR=1
