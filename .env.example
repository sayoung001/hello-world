# ───────────────────────────────────────────────────────────────
# Auto Trade (주식) — 환경변수 예시. 이 파일을 복사해 .env로 저장하세요.
#   cp .env.example .env  후 값 채우기 (.env는 .gitignore로 커밋 금지)
# ───────────────────────────────────────────────────────────────

# ── 한국투자증권 KIS Open API (실시간 시세/거래량 폭주 모니터) ──
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                 # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT_CODE=01     # 계좌상품코드 뒤 2자리 (보통 01)
KIS_ENV=real                    # real(실전) | paper(모의)

# ── Anthropic Claude (에이전트) ──
ANTHROPIC_API_KEY=
# 모델은 비워 두면 코드 기본값(claude-opus-5-5, $4/$20 per MTok)을 씁니다.
# 여기에 값을 적으면 코드 기본값을 덮어쓰니, 모델을 바꿀 때만 적으세요.
#   claude-sonnet-5-5  $2/$10   — 절반 비용, 일상 작업에 충분
#   claude-haiku-5-5   $0.10/$0.50 — 가장 저렴(단순 분류·요약용)
# ※ claude-opus-4-8($5/$25)은 구세대입니다 — opus-5-5 가 더 싸고 최신입니다.
#    예전 .env 에 opus-4-8 이 적혀 있으면 지우거나 주석 처리하세요.
# STOCK_AGENT_MODEL=

# ── 에이전트 재시도(선택) ── 일시 오류(429·5xx·네트워크)만 재시도합니다.
# 400 류(프롬프트·스키마 오류)는 재시도하지 않습니다 — 같은 결과가 나옵니다.
# STOCK_AGENT_RETRIES=2          # 재시도 횟수
# STOCK_AGENT_BACKOFF_SEC=3      # 첫 대기(초). 이후 2배씩 (3 → 6)

# ── Notion (배치 결과 아카이브 — 없어도 텔레그램으로는 옵니다) ──
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=          # 요약/문서 페이지를 붙일 부모 페이지 ID
NOTION_RECO_DB_ID=              # '오늘의 추천' DB ID (최초 셋업 후 채움)
NOTION_TRIGGER_DB_ID=           # '진입 신호 도달' DB ID
                                #   생성: python -m stock_auto.pipeline.check_triggers --setup-db

# ── Telegram (일일 추천 다이제스트 + 실시간 폭주 알림) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 데이터 루트(선택) ──
# 이 폴더 하나 아래에 ohlcv_cache / universe / earnings / profiles /
# observations / tracking 이 자동으로 만들어진다.
# 비워 두면 프로그램 실행 폴더의 data/ 를 쓴다.
# GCE에서 영구 디스크를 쓰려면 예: STOCK_DATA_DIR=/mnt/stock-data
STOCK_DATA_DIR=data

# ── 실시간 감시 종목 수 상한(선택) ──
# KIS는 접속당 실시간 등록 건수가 제한된다(정규 40건 내외).
KIS_MAX_SUBSCRIPTIONS=40

# ── 한국 시장도 켤 때만(선택) ── 기본은 미국장 전용
# ENABLE_KR=1

# ── 추천 차트 / 성과 추적(선택) ──
STOCK_CHART_MAX=5              # 다이제스트 뒤에 보낼 추천 차트 최대 장수
STOCK_TRACK_POSITION_USD=1000  # 가상계좌: 종목당 균등 투입 금액($)
STOCK_TRACK_FEE_BPS=0          # 가상계좌: 왕복 수수료·슬리피지(bp). 10 = 0.1%

# ── 트리아지 자동 표시(선택) ──
# 추천을 매일 손으로 "샀다/안 샀다" 입력하는 대신 일괄 표시한다.
#   yes = 게이트 통과 추천(AVOID 제외)을 전부 '샀다'로 표시 → 전량 매수 가정 관찰
#   no  = 전부 '안 샀다'로 표시                              → 추천만 쌓고 관망
# 비워 두면 표시하지 않고 미분류로 남긴다(기본). 미분류는 triage 로 직접 입력.
# STOCK_TRACK_AUTO_EXECUTE=yes

# ── 유니버스 강제 전환(디버깅용, 선택) ──
# sample 로 두면 지수 구성종목 대신 샘플 20종목만 스캔한다. 평소에는 비워 둔다.
# STOCK_UNIVERSE=sample
